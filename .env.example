# Copy this file to .env and fill in your own values. .env is gitignored — never commit it.

# Supabase → Project Settings → Database → Connect → Session pooler.
# Needed for scripts/import-seed.mjs and scripts/seed-to-sql.mjs (never used by the app itself).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Shown in the app; also used by import-seed.mjs as the families.name row.
FAMILY_NAME="Siddique Family"

# Only for scripts/seed-to-sql.mjs, to also make a login the first admin.
# ADMIN_EMAIL=siddiquema@gmail.com
# ADMIN_SEED_ID=g5_jin1
